gy marketing', 'Campaign creative', 'Support konsultasi rutin'],\r\n    highlight: false,\r\n  },\r\n]\r\n</script>\r\n\r\n<template>\r\n  <main class=\"page-shell\">\r\n    <header class=\"topbar\">\r\n      <NuxtLink to=\"/\" class=\"brand-wrap\">\r\n        <div class=\"brand-mark\">B</div>\r\n        <span>Berry Bloom</span>\r\n      </NuxtLink>\r\n\r\n      <nav class=\"nav\">\r\n        <NuxtLink to=\"/\">Home</NuxtLink>\r\n        <NuxtLink to=\"/about\">About</NuxtLink>\r\n        <NuxtLink to=\"/services\">Services</NuxtLink>\r\n        <NuxtLink to=\"/pricing\">Pricing</NuxtLink>\r\n        <NuxtLink to=\"/contact\">Kontak</NuxtLink>\r\n      </nav>\r\n    </header>\r\n\r\n    <section class=\"hero-card\">\r\n      <p class=\"eyebrow\">Pricing</p>\r\n      <h1>Pilih paket yang paling sesuai dengan kebutuhan brand Anda.</h1>\r\n\r\n      <div class=\"pricing-grid\">\r\n        <article v-for=\"plan in plans\" :key=\"plan.name\" :class=\"['plan-card', { highlight: plan.highlight }]\">\r\n          <p class=\"plan-name\">{{ plan.name }}</p>\r\n          <h2>{{ plan.price }}</h2>\r\n          <ul>\r\n            <li v-for=\"feature in plan.features\" :key=\"feature\">{{ feature }}</li>\r\n          </ul>\r\n          <NuxtLink to=\"/contact\" class=\"btn\">Pilih paket</NuxtLink>\r\n        </article>\r\n      </div>\r\n    </section>\r\n  </main>\r\n</template>\r\n\r\n<style scoped>\r\n:global(body) {\r\n  margin: 0;\r\n  font-family: 'Inter', 'Segoe UI', sans-serif;\r\n  background: #f3faf5;\r\n  color: #123127;\r\n}\r\n\r\n* { box-sizing: border-box; }\r\n\r\n.page-shell {\r\n  max-width: 1100px;\r\n  margin: 0 auto;\r\n  padding: 24px 20px 80px;\r\n}\r\n\r\n.topbar {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 24px;\r\n  padding: 20px 0 28px;\r\n}\r\n\r\n.brand-wrap {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  color: #1d1b1a;\r\n  text-decoration: none;\r\n  font-weight: 700;\r\n}\r\n\r\n.brand-mark {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 12px;\r\n  background: linear-gradient(135deg, #1bbf8a, #0d8f60);\r\n  color: #fff;\r\n  display: grid;\r\n  place-items: center;\r\n}\r\n\r\n.nav {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 20px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.nav a {\r\n  color: #214f41;\r\n  text-decoration: none;\r\n  font-weight: 600;\r\n}\r\n\r\n.hero-card {\r\n  background: linear-gradient(135deg, #ebfff5, #dff7ed);\r\n  border: 1px solid rgba(20, 96, 72, 0.08);\r\n  border-radius: 32px;\r\n  padding: 48px 32px;\r\n}\r\n\r\n.eyebrow {\r\n  margin: 0 0 18px;\r\n  font-size: 0.79rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n  color: #1a9b73;\r\n}\r\n\r\n.hero-card h1 {\r\n  margin: 0;\r\n  font-size: clamp(2.2rem, 4vw, 3.5rem);\r\n  line-height: 1.08;\r\n  letter-spacing: -0.05em;\r\n}\r\n\r\n.pricing-grid {\r\n  margin-top: 28px;\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 20px;\r\n}\r\n\r\n.plan-card {\r\n  padding: 26px 20px;\r\n  border-radius: 24px;\r\n  background: rgba(255, 255, 255, 0.7);\r\n  border: 1px solid rgba(130, 74, 67, 0.08);\r\n}\r\n\r\n.plan-card.highlight {\r\n  background: linear-gradient(135deg, #ecfff4, #d8f9e9);\r\n  border-color: rgba(14, 125, 86, 0.22);\r\n  transform: translateY(-4px);\r\n}\r\n\r\n.plan-name {\r\n  margin: 0 0 12px;\r\n  color: #6d514d;\r\n  font-weight: 700;\r\n}\r\n\r\n.plan-card h2 {\r\n  margin: 0 0 16px;\r\n  font-size: 2rem;\r\n  letter-spacing: -0.04em;\r\n}\r\n\r\n.plan-card ul {\r\n  margin: 0 0 20px;\r\n  padding-left: 18px;\r\n  color: #4f3d3b;\r\n  line-height: 2;\r\n}\r\n\r\n.btn {\r\n  display: inline-flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  width: 100%;\r\n  padding: 14px 20px;\r\n  border-radius: 999px;\r\n  background: linear-gradient(135deg, #18b57d, #0f8b63);\r\n  color: white;\r\n  text-decoration: none;\r\n  font-weight: 