      <NuxtLink to=\"/\">Home</NuxtLink>\r\n        <NuxtLink to=\"/about\">About</NuxtLink>\r\n        <NuxtLink to=\"/services\">Services</NuxtLink>\r\n        <NuxtLink to=\"/pricing\">Pricing</NuxtLink>\r\n        <NuxtLink to=\"/contact\">Kontak</NuxtLink>\r\n      </nav>\r\n    </header>\r\n\r\n    <section class=\"hero-card\">\r\n      <p class=\"eyebrow\">Layanan</p>\r\n      <h1>Solusi digital yang dibuat untuk tumbuh lebih cepat.</h1>\r\n\r\n      <div class=\"service-grid\">\r\n        <article v-for=\"service in services\" :key=\"service.title\" class=\"service-card\">\r\n          <div class=\"icon\">✦</div>\r\n          <h3>{{ service.title }}</h3>\r\n          <p>{{ service.text }}</p>\r\n        </article>\r\n      </div>\r\n    </section>\r\n  </main>\r\n</template>\r\n\r\n<style scoped>\r\n:global(body) {\r\n  margin: 0;\r\n  font-family: 'Inter', 'Segoe UI', sans-serif;\r\n  background: #f3faf5;\r\n  color: #123127;\r\n}\r\n\r\n* { box-sizing: border-box; }\r\n\r\n.page-shell {\r\n  max-width: 1100px;\r\n  margin: 0 auto;\r\n  padding: 24px 20px 80px;\r\n}\r\n\r\n.topbar {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 24px;\r\n  padding: 20px 0 28px;\r\n}\r\n\r\n.brand-wrap {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  color: #1d1b1a;\r\n  text-decoration: none;\r\n  font-weight: 700;\r\n}\r\n\r\n.brand-mark {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 12px;\r\n  background: linear-gradient(135deg, #1bbf8a, #0d8f60);\r\n  color: #fff;\r\n  display: grid;\r\n  place-items: center;\r\n}\r\n\r\n.nav {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 20px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.nav a {\r\n  color: #214f41;\r\n  text-decoration: none;\r\n  font-weight: 600;\r\n}\r\n\r\n.hero-card {\r\n  background: linear-gradient(135deg, #ebfff5, #dff7ed);\r\n  border: 1px solid rgba(20, 96, 72, 0.08);\r\n  border-radius: 32px;\r\n  padding: 48px 32px;\r\n}\r\n\r\n.eyebrow {\r\n  margin: 0 0 18px;\r\n  font-size: 0.79rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n  color: #1a9b73;\r\n}\r\n\r\n.hero-card h1 {\r\n  margin: 0;\r\n  font-size: clamp(2.2rem, 4vw, 3.5rem);\r\n  line-height: 1.08;\r\n  letter-spacing: -0.05em;\r\n}\r\n\r\n.service-grid {\r\n  margin-top: 28px;\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 20px;\r\n}\r\n\r\n.service-card {\r\n  padding: 24px;\r\n  border-radius: 24px;\r\n  background: rgba(255, 255, 255, 0.74);\r\n  border: 1px solid rgba(130, 74, 67, 0.08);\r\n}\r\n\r\n.icon {\r\n  width: 52px;\r\n  height: 52px;\r\n  border-radius: 16px;\r\n  display: grid;\r\n  place-items: center;\r\n  background: linear-gradient(135deg, #dff8ec, #c6f0dd);\r\n  font-size: 1.3rem;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.service-card h3 {\r\n  margin: 0 0 10px;\r\n  font-size: 1.35rem;\r\n}\r\n\r\n.service-card p {\r\n  margin: 0;\r\n  color: #456f60;\r\n  line-height: 1.7;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .topbar {\r\n    display: grid;\r\n    justify-content: center;\r\n    text-align: center;\r\n  }\r\n\r\n  .nav {\r\n    justify-content: center;\r\n  }\r\n\r\n  .service-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n</style>\r\n","<script setup lang=\"ts\">\r\nconst services = [\r\n  {\r\n    title: 'Brand Identity',\r\n    text: 'Membuat identitas visual yang konsisten mulai dari logo, warna, hingga tone komunikasi brand.',\r\n  },\r\n  {\r\n    title: 'Landing Page',\r\n    text: 'Desain landing page yang fokus pada konversi, storytelling, dan pengalaman pengguna yang jelas.',\r\n  },\r\n  {\r\n    title: 'Marketing Creative',\r\n    text: 'Siapkan materi promosi, konten visual, dan strategi campaign yang siap dipakai di berbagai channel.',\r\n  },\r\n]\r\n</script>\r\n\r\n<template>\r\n  <main class=\"page-shell\">\r\n    <header class=\"topbar\">\r\n      <NuxtLink to=\"/\" class=\"brand-wrap\">\r\